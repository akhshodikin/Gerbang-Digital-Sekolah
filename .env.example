# Environment Variables - Sistem Absensi Terintegrasi SDN Kandangan I Tosari

NODE_ENV=development
PORT=5000

# Judul dan Identitas Aplikasi
NEXT_PUBLIC_APP_NAME="ABSENSI QR CODE SDN KANDANGAN I TOSARI"
NEXT_PUBLIC_SCHOOL_NAME="SDN Kandangan I Tosari"
NEXT_PUBLIC_SCHOOL_REGION="Kecamatan Tosari, Kabupaten Pasuruan, Jawa Timur"

# Database Configuration
# Kosongkan DATABASE_URL untuk menggunakan PGlite lokal bawaan (PostgreSQL embedded zero-config di ./data/pglite)
# Atau isi dengan koneksi PostgreSQL jika menggunakan PostgreSQL eksternal / Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/absensi_sdn_kandangan
DATABASE_URL=

# Autentikasi dan Keamanan
AUTH_SECRET=sdn-kandangan-tosari-secret-key-32chars-minimum-security-2026-production
SESSION_MAX_AGE_SECONDS=86400

# Penyimpanan Berkas Privat (bukti perizinan, pelanggaran)
UPLOAD_DIR="./uploads"

# Integrasi WhatsApp Business Platform (Opsional)
# Status akan muncul "Belum Dikonfigurasi" di dashboard jika belum diisi
WA_GATEWAY_URL=
WA_API_TOKEN=
WA_SENDER_NUMBER=
