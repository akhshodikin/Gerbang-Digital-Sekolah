# ==============================================================================
# Environment Variables - GDS : Gerbang Digital Sekolah (SDN Kandangan I Tosari)
# ==============================================================================

NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 1. Judul & Identitas Aplikasi
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="GDS : Gerbang Digital Sekolah"
NEXT_PUBLIC_SCHOOL_NAME="SDN Kandangan I Tosari"
NEXT_PUBLIC_SCHOOL_REGION="Kecamatan Tosari, Kabupaten Pasuruan, Jawa Timur"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# UNTUK DEPLOYMENT KE VERCEL (Standar Modern Serverless):
# Gunakan Cloud PostgreSQL gratis seperti Neon (neon.tech), Supabase, atau Vercel Postgres.
# Format: postgresql://[user]:[password]@[host]:5432/[database]?sslmode=require
# Contoh Neon: postgresql://neondb_owner:npg_xxxx@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Untuk pengembangan lokal di komputer tanpa Docker / tanpa database server:
# Kosongkan DATABASE_URL di atas, sistem otomatis menggunakan embedded PGlite di ./data/pglite

# ------------------------------------------------------------------------------
# 3. Autentikasi & Keamanan Sesi
# ------------------------------------------------------------------------------
# Kunci enkripsi cookie JWT sesi pengguna (wajib minimal 32 karakter unik di produksi)
AUTH_SECRET=sdn-kandangan-tosari-secret-key-32chars-minimum-security-2026-production
SESSION_MAX_AGE_SECONDS=86400

# ------------------------------------------------------------------------------
# 4. Penyimpanan Berkas Privat (Surat Izin / Foto)
# ------------------------------------------------------------------------------
# Di Vercel, biarkan kosong agar otomatis menggunakan direktori serverless /tmp/uploads
UPLOAD_DIR=

# ------------------------------------------------------------------------------
# 5. Integrasi WhatsApp Gateway (Opsional)
# ------------------------------------------------------------------------------
WA_GATEWAY_URL=
WA_API_TOKEN=
WA_SENDER_NUMBER=
